DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"

# Endereço público da aplicação — usado para montar os links absolutos que vão por e-mail.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-mail (Resend). Leave RESEND_API_KEY empty in dev — e-mails are logged to the console
# instead of sent. Without a verified domain, Resend only delivers to the account owner.
RESEND_API_KEY=""
# Sem aspas: o valor vai literal para o painel de deploy, e a Resend recusa `"..."` com 422.
EMAIL_FROM=NutriMatch <onboarding@resend.dev>


# ── Pix ──────────────────────────────────────────────────────────────────────────────────
# Chave Pix da PLATAFORMA: é para ela que o paciente paga. Sem esta variável nenhuma cobrança
# é gerada e o app funciona como antes de existir pagamento — a consulta é combinada
# diretamente entre paciente e profissional.
#
# Chave Pix estática não tem webhook: ninguém avisa quando o dinheiro cai. A confirmação é
# feita à mão em /admin/financeiro, conferindo valor e identificador no extrato.
PLATFORM_PIX_KEY=""
# Nome e cidade do recebedor, como aparecem no app do banco do pagador.
PLATFORM_PIX_NAME="NutriMatch"
PLATFORM_PIX_CITY="Sao Paulo"
# Platform commission on each payment, in percent. 10 = NutriMatch keeps 10%.
PLATFORM_FEE_PERCENT="10"

# When the nutritionist subscription starts being required to receive bookings.
# LEAVE EMPTY to keep the grace period open: every professional keeps receiving bookings
# regardless of plan. Setting a past date turns the paywall on immediately — free-plan
# professionals stop receiving bookings from that instant, so announce it before you set it.
SUBSCRIPTION_ENFORCED_FROM=""

# Video consultations. Defaults to the public meet.jit.si; point it at your own Jitsi if you
# need the room to stay inside infrastructure you control.
JITSI_HOST=""

# Shared secret for /api/cron/reminders, sent as `Authorization: Bearer <secret>`.
# While empty the endpoint answers 503 and sends nothing — deliberately closed, because an
# open version of this route would e-mail every upcoming appointment on demand.
# Generate with: openssl rand -hex 32
CRON_SECRET=""
