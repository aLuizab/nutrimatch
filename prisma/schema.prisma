generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PROFESSIONAL
  ADMIN
}

enum ProfessionalStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Modality {
  ONLINE
  PRESENCIAL
  AMBOS
}

enum AppointmentStatus {
  // Marcada pelo paciente e aguardando **o pagamento** — nunca mais aguardando o profissional.
  // Segura o horário, mas ainda não é consulta de verdade. Quem a transforma em CONFIRMED é a
  // conferência do extrato pelo admin (ver lib/pix-payments.ts), e não uma resposta dele.
  AWAITING_CONFIRMATION
  CONFIRMED
  CANCELLED
  // O prazo passou sem o pagamento ser confirmado. Distinto de CANCELLED porque ninguém decidiu
  // nada: o pedido simplesmente não virou consulta.
  //
  // **Não conta contra a confiabilidade de ninguém.** Quando existia o aceite, expirar era o
  // profissional deixando o prazo correr, e pesava contra ele; hoje é o paciente que não pagou,
  // ou a plataforma que não conferiu a tempo. Ver lib/reputation.ts.
  EXPIRED
}

// Quem apareceu na consulta. Separado de AppointmentStatus de propósito: uma consulta pode
// estar CONFIRMED (combinada, paga, horário ocupado) e mesmo assim ninguém ter aparecido —
// são duas perguntas diferentes sobre o mesmo compromisso.
enum AttendanceStatus {
  // Ainda não avaliada. Passados ATTENDANCE_AUTO_RESOLVE_DAYS, lib/reputation.ts trata como
  // ATTENDED na leitura: ninguém pode ser penalizado porque o outro lado não marcou nada.
  PENDING
  ATTENDED
  NO_SHOW
  // O paciente contestou a falta. Para de contar contra qualquer um dos dois até alguém
  // resolver — uma marcação em disputa não é evidência de nada.
  CONTESTED
}

// O ciclo do dinheiro de uma consulta. NOT_REQUIRED é o estado de quem fica fora do caixa da
// plataforma: profissional sem link de pagamento ou sem chave Pix, ou consulta já coberta por um
// pacote pago. Manter esse estado explícito é o que preserva a degradação graciosa — sem os dois
// lados do caminho do dinheiro o app segue funcionando como antes de existir pagamento.
enum PaymentStatus {
  NOT_REQUIRED
  // Cobrança criada, aguardando o paciente pagar. O horário fica preso, mas por pouco tempo.
  PENDING
  // O paciente declarou que pagou e a plataforma ainda não conferiu o extrato. Link de
  // cobrança não emite webhook, então esta etapa é humana por necessidade, não por escolha.
  AWAITING_REVIEW
  // Conferido no extrato e confirmado por um admin. É aqui que o repasse passa a existir.
  PAID
  // ── Inalcançáveis ────────────────────────────────────────────────────────────────────
  // Nenhum caminho do código grava os três abaixo. AUTHORIZED e VOIDED vinham de reserva em
  // cartão, que esta plataforma não faz; REFUNDED pressupunha estorno automático, e a
  // devolução é manual. Continuam declarados porque remover valor de enum no Postgres é
  // mudança de contração: só depois de garantir que nenhuma linha os usa. Ver CHANGELOG.
  AUTHORIZED
  VOIDED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  // A mensalidade venceu e não foi paga. O acesso continua durante o período de carência (ver
  // lib/subscription.ts): cortar no primeiro dia de atraso puniria um esquecimento como se fosse
  // desistência.
  PAST_DUE
  CANCELLED
}

// No COMPLETED member: completion is derivable (consultas usadas >= incluídas, or past endsAt),
// and an enum value no code path can produce is dead weight.
enum EnrollmentStatus {
  // Checkout do pacote aberto e ainda não pago. Não vale como acompanhamento ativo: não
  // libera consulta, não conta como matrícula, e some sozinho se o pagamento não vier.
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role
  createdAt    DateTime @default(now())

  // Session revocation epoch: lib/session.ts rejects any token issued before this instant,
  // so changing the password logs out every other device. Without it a stolen cookie is
  // valid for its full 7-day life with no way to kill it.
  passwordChangedAt DateTime?

  // E-mail notification preferences. Currently only honored for PROFESSIONAL recipients —
  // patient-facing e-mails (booking/cancel confirmations) are transactional and always sent.
  notifyBooking      Boolean @default(true)
  notifyCancellation Boolean @default(true)
  notifyReviews      Boolean @default(true)
  // Comunicados da plataforma — novidades, mudanças de regra, avisos gerais. Separado das
  // outras três porque é a única categoria que não responde a algo que a pessoa fez: as demais
  // são transacionais e silenciá-las é escolha dela; esta é a que a lei chama de comunicação
  // não solicitada se não houver como sair.
  notifyNews         Boolean @default(true)

  // Foto de perfil hospedada no Cloudinary. Guardamos a URL servida e o publicId, que é o
  // que permite apagar a imagem antiga ao trocar — sem ele cada troca deixa um arquivo órfão
  // consumindo a cota para sempre.
  photoUrl      String?
  photoPublicId String?

  professional Professional?
  patient      Patient?
  resetTokens  PasswordResetToken[]
  goalsCreated Goal[]               @relation("GoalAuthor")
}

model Professional {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  crn         String
  specialties String[]
  bio         String
  city        String
  modality    Modality
  price       Int
  status      ProfessionalStatus @default(ACTIVE)
  rating      Float              @default(0)
  reviewCount Int                @default(0)
  createdAt   DateTime           @default(now())

  // Weighted ranking score, materialised because Postgres can't ORDER BY / paginate over a
  // score computed in application memory. Recomputed by lib/ranking.ts whenever an input
  // changes (new review, new confirmation). Paid subscriptions deliberately do NOT feed this
  // — sponsored placement is a separate, labelled slot, never a hidden boost.
  rankScore          Float     @default(0)
  // ── Legado ───────────────────────────────────────────────────────────────────────────
  // Media de segundos entre o agendamento e o profissional aceitar. Nada escreve mais aqui:
  // desde que a confirmação passou a ser do admin (o profissional não aceita mais, só pode
  // cancelar), o que este número mediria seria a demora do admin em conferir o extrato — e
  // rankear o profissional por isso seria cobrar dele o tempo de outra pessoa. Continua
  // declarada porque derrubar coluna é mudança de contração: só depois de nenhuma leitura
  // sobrar. Ver CHANGELOG.
  medianResponseSecs Int?
  rankUpdatedAt      DateTime?

  // ── Reputação ────────────────────────────────────────────────────────────────────────
  // Composto de qualidade (avaliações), resposta e confiabilidade — 0..1. Materializado
  // pela mesma razão de rankScore: é entrada de ordenação e de filtro, e recalcular em
  // memória a cada busca não escala. Ver lib/reputation.ts.
  reputationScore Float  @default(0)
  // Nível exibido (NOVO / CONFIAVEL / DESTAQUE / REFERENCIA). String e não enum porque as
  // faixas são regra de produto e mudam sem migração — o enum obrigaria uma a cada ajuste.
  tier            String @default("NOVO")
  // Consultas que efetivamente aconteceram. É o "volume mínimo" que impede uma nota alta
  // com 3 consultas de virar nível máximo.
  fulfilledCount  Int    @default(0)

  // Audit trail for CRN verification. There is no official CRN API (see lib/crn.ts), so an
  // admin confirms the registration against the CFN portal manually; these record who did it
  // and when, so an approval is never anonymous.
  crnVerifiedAt DateTime?
  crnVerifiedBy String?

  // ── Recebimento por Pix ──────────────────────────────────────────────────────────────
  // O paciente paga na chave da plataforma; a plataforma repassa aqui, já descontada a taxa.
  // Sem chave cadastrada não há como repassar, então o profissional não entra no fluxo pago —
  // mesmo papel que a flag de conta conectada tinha, agora sem onboarding de documentos.
  // ── Link de pagamento da consulta avulsa ────────────────────────────────────────────
  // Criado pelo admin no InfinitePay com o valor desta pessoa e colado aqui. Um link por
  // profissional porque o link carrega valor fixo, e o valor é o preço dele.
  paymentLinkUrl       String?
  // O preço para o qual o link foi criado, em reais inteiros, como Professional.price. Guardado
  // para detectar o link envelhecido: o profissional muda o preço na tela dele e o link continua
  // cobrando o valor antigo, sem nada avisando ninguém. Comparar os dois é o que torna isso
  // visível em vez de virar diferença de caixa descoberta semanas depois.
  paymentLinkAmount    Int?
  paymentLinkUpdatedAt DateTime?

  pixKey     String?
  // CPF | CNPJ | EMAIL | PHONE | RANDOM. String e não enum: o Bacen pode passar a aceitar outro
  // tipo, e isso não deveria custar uma migração.
  pixKeyType String?

  subscription          ProfessionalSubscription?
  payouts               Payout[]
  availabilityRules     AvailabilityRule[]
  availabilityOverrides AvailabilityOverride[]
  appointments          Appointment[]
  reviews               Review[]
  carePlans             CarePlan[]
  enrollments           Enrollment[]

  @@index([status])
}

model Patient {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate      DateTime?
  goal           String?
  city           String?
  targetWeightKg Float?
  createdAt      DateTime  @default(now())

  // ── Campanha de boas-vindas: 10% na consulta para os primeiros inscritos ─────────────
  // Posição na campanha (1..WELCOME_DISCOUNT_SLOTS), atribuída no cadastro e nunca reusada.
  // Null para quem chegou depois das vagas acabarem — esta coluna é, ela mesma, a flag que o
  // painel mostra. Número em vez de boolean porque é o que vira o código do cupom (NUTRI10-042):
  // a paciente cita o código, o admin acha a linha. Um boolean identificaria só "tem desconto".
  //
  // Único de propósito: com cadastros simultâneos duas transações leem o mesmo máximo, e é este
  // índice que impede as duas de saírem com o cupom 042. Ver lib/welcome-discount.ts.
  welcomeDiscountSeq Int?      @unique
  welcomeDiscountAt  DateTime?

  appointments    Appointment[]
  reviews         Review[]
  enrollments     Enrollment[]
  progressEntries ProgressEntry[]
  goals           Goal[]
}

/// A grade que se repete toda semana. É o padrão; uma data específica pode fugir dele —
/// ver AvailabilityOverride.
model AvailabilityRule {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int
  startTime      String
  endTime        String
  slotMinutes    Int          @default(50)

  @@index([professionalId])
}

/// O que acontece numa data específica, quando ela não segue a semana: feriado, viagem,
/// congresso, ou um sábado de mutirão que não existe na grade normal.
///
/// Existe como tabela separada, e não como mais linhas em AvailabilityRule, porque as duas
/// respondem a perguntas diferentes e têm ciclos de vida diferentes: a grade semanal é
/// permanente e reescrita inteira a cada salvamento, enquanto uma exceção vale para um dia só e
/// deixa de importar quando aquele dia passa. Misturá-las faria "salvar meus horários" apagar as
/// férias que a pessoa marcou três telas antes.
///
/// A data é `String` no formato 'YYYY-MM-DD', e não DateTime, pelo mesmo motivo que lib/spdate.ts
/// existe: o que se quer guardar aqui é um dia do calendário de São Paulo, não um instante. Um
/// DateTime obrigaria toda leitura a lembrar do fuso para não exibir o dia anterior.
model AvailabilityOverride {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  date           String

  /// Dia fechado: nenhum horário, mesmo que a grade semanal diga o contrário. Uma linha assim
  /// vence qualquer outra da mesma data — é a forma de dizer "não atendo neste dia" sem
  /// precisar apagar a grade da semana inteira.
  closed Boolean @default(false)

  /// Bloco de horário especial para esta data. Quando existe ao menos um, eles **substituem** a
  /// grade semanal naquele dia, em vez de somar: quem abre um horário fora do comum quase sempre
  /// quer só aquele horário, e somar criaria vagas que a pessoa não pediu. Nulos quando closed.
  startTime String?
  endTime   String?

  createdAt DateTime @default(now())

  @@index([professionalId, date])
}

model Appointment {
  id                   String            @id @default(cuid())
  professionalId       String
  professional         Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId            String
  patient              Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledAt          DateTime
  // Mirrors scheduledAt while this row occupies the slot (CONFIRMED); set back to null once it
  // doesn't (CANCELLED). Postgres treats NULLs as distinct within a unique index, so a
  // cancelled appointment's slot becomes bookable again — the unique constraint lives on this
  // column, never on scheduledAt itself, which stays untouched for history.
  slotHeldAt           DateTime?
  modality             Modality
  price                Int
  status               AppointmentStatus @default(AWAITING_CONFIRMATION)
  // Quando a consulta passou a valer. Hoje é o instante em que o admin confirmou o pagamento,
  // não uma resposta do profissional — ele não aceita mais consulta nenhuma.
  confirmedAt          DateTime?
  // Prazo para a conferência do pagamento declarado. Passado ele sem confirmação, o horário é
  // tratado como livre. Derivado na leitura (ver lib/availability.ts) — sem cron, como todo
  // estado baseado em tempo neste projeto.
  //
  // O nome ficou do tempo em que este era o prazo do profissional aceitar. Renomear coluna é
  // mudança de contração, e "até quando esta consulta pode ficar sem confirmação" continua
  // descrevendo o que ela guarda. Ver paymentReviewDeadlineFor em lib/appointment-status.ts.
  confirmationDeadline DateTime?
  reason               String?
  phone                String?
  // Post-consultation notes written by the professional, visible to the patient.
  summary              String?
  // Jitsi room for ONLINE consultations. The room name IS the access control on public
  // Jitsi, so it must be unpredictable — a sequential or derivable id would let anyone walk
  // into someone else's health consultation.
  meetingRoom          String?           @unique
  // ── Pagamento ────────────────────────────────────────────────────────────────────────
  paymentStatus        PaymentStatus     @default(NOT_REQUIRED)
  // Prazo para o paciente pagar no link e avisar. Enquanto corre, o horário fica preso — por
  // 30 minutos e não por 24h: um pedido abandonado não pode bloquear a agenda de alguém.
  // O relógio para quando o paciente declara o pagamento; daí quem vale é o prazo de
  // conferência do admin. Ver PAYMENT_HOLD_MINUTES em lib/payments.ts.
  paymentDeadline      DateTime?
  paidAt               DateTime?
  // Em centavos, ao contrário de price (reais inteiros): a taxa de 10% precisa de arredondamento
  // exato, e centavo inteiro é a única forma de dividir dinheiro sem sobra. Ver lib/money.ts.
  amountCents          Int?
  feeCents             Int?

  // ── Cobrança por Pix ─────────────────────────────────────────────────────────────────
  // Identificador que vai dentro do BR Code e aparece no extrato — é por ele que a conferência
  // manual acha a linha certa. Ver lib/pix.ts.
  pixTxid       String?   @unique
  // Quando o paciente declarou ter pago. Declaração, não prova: só move a cobrança da fila de
  // 'aguardando pagamento' para a de 'conferir extrato'.
  pixClaimedAt  DateTime?
  // Observação do paciente ao declarar (ex.: o E2E do comprovante).
  pixClaimNote  String?
  // Quem conferiu o extrato e confirmou. Dinheiro confirmado por alguém tem nome.
  pixReviewedBy String?
  pixReviewedAt DateTime?

  payout Payout?

  // ── Comparecimento e reputação ───────────────────────────────────────────────────────
  attendance            AttendanceStatus @default(PENDING)
  attendanceMarkedAt    DateTime?
  attendanceContestedAt DateTime?
  // Justificativa que o paciente escreve ao contestar uma falta.
  attendanceNote        String?
  // Quem cancelou. Antes isto existia só como argumento do e-mail (lib/notifications.ts) e
  // se perdia — sem persistir, não há como distinguir "o profissional desmarcou" de "o
  // paciente desmarcou", e confiabilidade do profissional deixa de ser calculável.
  cancelledAt           DateTime?
  cancelledBy           Role?

  // Set when the consultation was booked inside a care program. SetNull (not Cascade) —
  // deleting an enrollment must never destroy consultation history.
  enrollmentId String?
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  review Review?

  @@unique([professionalId, slotHeldAt])
  @@index([patientId])
  @@index([professionalId])
  @@index([enrollmentId])
  // Every trend aggregation (lib/trends.ts) filters by period and groups by status; without
  // these both the admin dashboard and /admin/tendencias fall back to a full table scan.
  @@index([scheduledAt])
  @@index([status, scheduledAt])
  @@index([createdAt])
}

// A care program offered by a professional: N consultations over M months at a per-consultation
// price below their one-off price. The platform does not process payment — this records the
// agreed terms, the money is still arranged directly between patient and professional.
model CarePlan {
  id                   String       @id @default(cuid())
  professionalId       String
  professional         Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  name                 String
  description          String
  durationMonths       Int
  consultations        Int
  pricePerConsultation Int
  active               Boolean      @default(true)
  createdAt            DateTime     @default(now())

  // Link próprio porque o valor do pacote (pricePerConsultation x consultations) não é o da
  // consulta avulsa, e um link do InfinitePay cobra um valor só.
  paymentLinkUrl       String?
  paymentLinkAmount    Int?
  paymentLinkUpdatedAt DateTime?

  enrollments Enrollment[]

  @@index([professionalId, active])
}

model Enrollment {
  id             String           @id @default(cuid())
  carePlanId     String
  carePlan       CarePlan         @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional     @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  status         EnrollmentStatus @default(ACTIVE)

  // Snapshots taken at enrollment: editing the plan later must not change anyone already on it,
  // and listPriceAtEnrollment keeps the "programa vs avulso" comparison stable even if the
  // professional edits their one-off price afterwards.
  pricePerConsultation  Int
  consultations         Int
  listPriceAtEnrollment Int

  // ── Pagamento do pacote ──────────────────────────────────────────────────────────────
  // O pacote é cobrado de uma vez, na compra. Diferente da consulta avulsa, aqui a captura é
  // imediata: não há um profissional para confirmar a compra de um programa.

  paidAmountCents Int?
  feeCents        Int?
  paidAt          DateTime?
  // Cobrança por Pix do pacote — mesmo mecanismo da consulta avulsa. Enquanto pixClaimedAt
  // for null e o status PENDING_PAYMENT, ninguém declarou pagamento ainda.
  pixTxid         String?   @unique
  pixClaimedAt    DateTime?
  pixClaimNote    String?
  pixReviewedBy   String?
  pixReviewedAt   DateTime?

  // Estorno proporcional das consultas não usadas ao fim do prazo. Guardado em vez de
  // recalculado para que a devolução aconteça uma vez só, e para que o valor devolvido fique
  // registrado mesmo se o preço do programa mudar depois.
  refundedCents Int       @default(0)
  refundedAt    DateTime?

  startedAt DateTime @default(now())
  endsAt    DateTime
  createdAt DateTime @default(now())

  appointments Appointment[]

  @@index([patientId])
  @@index([professionalId])
}

// Patient-recorded measurements. Sensitive health data under LGPD — see the notice on the
// progress form about visibility to professionals the patient has consultations with.
model ProgressEntry {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  weightKg   Float?
  waistCm    Float?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([patientId, recordedAt])
  @@index([patientId, recordedAt])
}

// Single-use password reset tokens. Only the SHA-256 hash is stored: a leaked database dump
// then yields nothing usable, the same reasoning as never storing raw passwords.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Who read whose health data, and when. LGPD Art. 37 requires records of processing
// operations over sensitive data; before this the only audit trail in the whole system was
// CRN verification.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRole Role
  action    String
  subjectId String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([subjectId, createdAt])
  @@index([actorId, createdAt])
}

// Os planos à venda. Uma linha por plano em vez de constantes no código, para que o preço e o
// link de cobrança mudem sem deploy, e para o admin ver o que está sendo vendido de fato.
model SubscriptionPlan {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  name                 String
  description          String
  // Cents per month. 0 for the free tier, which exists as a real row so a professional always
  // has a plan and the "no subscription" case doesn't need special handling everywhere.
  monthlyPrice         Int
  // Link do InfinitePay que cobra a mensalidade deste plano, cadastrado pelo admin — mesmo
  // arranjo do link por profissional e do link por pacote. Null no plano gratuito, que não
  // cobra nada, e enquanto o admin não criar o link.
  paymentLinkUrl       String?
  paymentLinkAmount    Int?
  paymentLinkUpdatedAt DateTime?
  // Whether this tier is eligible for the labelled "Patrocinado" band. Deliberately a plan
  // property and NOT an input to Professional.rankScore — see lib/subscription.ts.
  sponsored            Boolean   @default(false)
  canReceiveBookings   Boolean   @default(true)
  active               Boolean   @default(true)
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())

  subscriptions ProfessionalSubscription[]
}

model ProfessionalSubscription {
  id             String             @id @default(cuid())
  professionalId String             @unique
  professional   Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(ACTIVE)

  // When the paid period runs out. Null on the free tier, which never expires.
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// One row per (appointment, reminder kind) that has actually been sent. The unique key IS the
// idempotency mechanism: the cron inserts before sending, so a second run in the same window
// hits the constraint and skips instead of e-mailing the patient twice: registrar a intenção
// antes de agir é o que torna o handler seguro para repetir.
model SentReminder {
  id            String   @id @default(cuid())
  appointmentId String
  kind          String
  sentAt        DateTime @default(now())

  @@unique([appointmentId, kind])
  @@index([sentAt])
}

// Quanto a plataforma deve a cada profissional, por consulta.
//
// Existe porque o dinheiro passa inteiro pela conta da plataforma: o paciente paga o total na
// chave Pix da NutriMatch, e o repasse (total − taxa) é uma transferência manual depois. Sem
// esta tabela, 'quanto eu tenho a receber' viraria uma conta refeita na mão a cada pergunta, e
// ninguém saberia o que já foi pago.
//
// Uma linha por consulta, e não um saldo acumulado: saldo não conta história, e quando um
// repasse é contestado é a linha da consulta que precisa ser olhada.
model Payout {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  // SetNull e não Cascade: apagar a consulta não pode apagar o registro de um dinheiro que
  // saiu de verdade.
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Em centavos, como todo valor que passa pelo caixa (ver lib/money.ts). grossCents é o que o
  // paciente pagou; netCents é o que o profissional recebe.
  grossCents Int
  feeCents   Int
  netCents   Int

  status         PayoutStatus @default(PENDING)
  // Snapshot da chave no momento do repasse: se o profissional trocar a chave depois, o
  // histórico precisa continuar mostrando para onde o dinheiro realmente foi.
  pixKeySnapshot String?
  // Quando o admin declarou ter feito a transferência (entrada em PROCESSING). Separado de
  // paidAt porque são dois fatos com datas diferentes: "mandei" e "está comprovado".
  sentAt         DateTime?
  paidAt         DateTime?
  paidBy         String?
  note           String?
  createdAt      DateTime     @default(now())

  // Comprovante da transferência. É o que separa PROCESSING de PAID: sem arquivo aqui o
  // repasse não é dado como concluído. SetNull e não Cascade — apagar o arquivo não pode
  // apagar o registro do dinheiro que saiu.
  receiptFileId String?     @unique
  receiptFile   StoredFile? @relation("PayoutReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)

  @@index([professionalId, status])
  @@index([status, createdAt])
}

enum PayoutStatus {
  // Devido e ainda não transferido. É também onde fica quem não tem chave Pix cadastrada: a
  // consulta acontece, o dinheiro fica retido, e a dívida segue registrada.
  PENDING
  // O admin declarou que fez a transferência e o comprovante ainda não foi anexado. Estado
  // próprio, e não um bóóleano em PAID, porque é exatamente o que o profissional precisa ver
  // para saber que o dinheiro saiu mas ainda não foi comprovado.
  PROCESSING
  // Transferido **e** comprovado. Sem comprovante anexado nada chega aqui — ver
  // lib/payouts.ts: "pago" sem documento é só a palavra de quem pagou.
  PAID
  // A consulta foi cancelada e estornada antes do repasse sair — não há mais o que repassar.
  CANCELLED
}

/// Arquivo guardado no próprio banco: comprovante de repasse hoje, foto de perfil depois.
///
/// Bytes no Postgres em vez de um serviço de arquivos. É uma escolha de escala, não de
/// preguiça: são poucos arquivos, pequenos, e a alternativa era uma credencial externa a mais
/// para criar, girar e vazar. Quando o volume não couber mais aqui, é este model que troca de
/// implementação — quem o usa referencia um id, nunca um caminho de arquivo.
///
/// Não há rota pública que liste isto. Comprovante de repasse é documento financeiro de duas
/// pessoas específicas; quem pode ver cada arquivo é decidido em /api/arquivos/[id].
model StoredFile {
  id         String   @id @default(cuid())
  mimeType   String
  /// Guardado em coluna própria para a listagem mostrar o tamanho sem carregar os bytes.
  sizeBytes  Int
  /// Nome original, só para o download sair com algo reconhecível.
  fileName   String
  bytes      Bytes
  /// Quem enviou. Arquivo no banco sem responsável é arquivo que ninguém responde por.
  uploadedBy String
  createdAt  DateTime @default(now())

  payoutReceipt Payout? @relation("PayoutReceipt")

  @@index([uploadedBy, createdAt])
}

model Review {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId  String?      @unique
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  rating         Int
  comment        String
  createdAt      DateTime     @default(now())

  @@index([professionalId])
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

/// Metas do paciente. Separadas de Patient.goal, que é o objetivo genérico escolhido no
/// cadastro ("Emagrecimento") e serve para busca e triagem — isto aqui é o acompanhamento
/// concreto, com prazo e progresso.
///
/// authorId guarda quem criou porque as duas origens têm peso diferente: uma meta que o
/// nutricionista definiu faz parte do plano dele e o paciente não deve poder apagá-la, enquanto
/// a que o próprio paciente escreveu é dele. Sem esse campo as duas viram a mesma coisa.
model Goal {
  id        String  @id @default(cuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("GoalAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title       String
  description String?

  /// Meta numérica opcional: 72 kg, 2 litros de água, 3 treinos por semana. Quando target e
  /// unit são nulos a meta é só um hábito a marcar como concluído.
  targetValue  Float?
  currentValue Float?
  /// Ponto de partida, gravado na criação. É o que permite calcular progresso em metas
  /// decrescentes: sem ele, emagrecer de 85 para 72 faz a barra andar para trás a cada quilo.
  startValue   Float?
  unit         String?

  dueDate    DateTime?
  status     GoalStatus @default(ACTIVE)
  achievedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, status])
}
